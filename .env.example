# Secrets (never commit real values)
# INEGI_API_TOKEN is only needed to regenerate the dataset with
# `python -m scripts.ingest_denue`. Register for a free token at
# https://www.inegi.org.mx/servicios/api_denue.html
INEGI_API_TOKEN=
# Optional Gemini explanation layer. Leave both blank to run fully offline.
GEMINI_API_KEY=
GEMINI_MODEL=

# Local embeddings (must match the model recorded in data/manifest.json)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Inside Docker the model is cached here. On a developer machine this path is
# usually not writable and the app falls back to ~/.cache automatically.
FASTEMBED_CACHE_PATH=/app/.cache/fastembed

# HTTP and safety limits
ALLOWED_ORIGINS=http://localhost:8000
MAX_QUESTION_LENGTH=500
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.57
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
# Set to true only behind a proxy that sets X-Forwarded-For (Render does).
TRUST_PROXY_HEADERS=false
LOG_LEVEL=INFO
PORT=8000
